            "timeout": 300,
            "interval": 15
          }
        },
        {
          "name": "create-ske-cluster",
          "service": "ske",
          "method": "POST",
          "path": "/v1/clusters",
          "json": {
            "name": "regrske{unique}",
            "kubernetes_version": "{kube_ver}",
            "cloud_logging_enabled": "false",
            "vpc_id": "{vpc_id}",
            "subnet_id": "{subnet_id}",
            "security_group_id_list": [
              "{sg_id}"
            ],
            "private_endpoint_access_control_resources": [],
            "tags": [],
            "volume_id": "{volume_id}",
            "public_endpoint_access_control_ip": "0.0.0.0/0",
            "service_watch_logging_enabled": "true"
          },
          "expect_status": [
            200,
            201,
            202
          ],
          "capture": {
            "cluster_id": "$.resource_id"
          },
          "cleanup": {
            "method": "DELETE",
            "path": "/v1/clusters/{cluster_id}",
            "service": "ske"
          }
        },
        {
          "name": "wait-ske-cluster",
          "service": "ske",
          "method": "GET",
          "path": "/v1/clusters/{cluster_id}",
          "expect_status": [
            200
          ],
          "poll": {
            "field": "$.cluster.status",
            "until": [
              "RUNNING",
              "ACTIVE",
              "Running"
            ],
            "timeout": 1800,
            "interval": 30
          }
        },
        {
          "name": "cloudml-cluster-readable",
          "service": "cloud-ml",
          "method": "GET",
          "path": "/v1/cloud-ml/clusters/{cluster_id}",
          "expect_status": [
            200,
            400,
            403,
            404,
            409,
            422
          ],
          "optional": true,
          "group": "cloud-ml-precond",
          "_note": "id-bound cluster precondition GET against the REAL RUNNING cluster_id — expect 200; tolerate 4xx (optional+grouped) so a precondition hiccup does not abandon the live cluster before teardown. Closes coverage_gap GAP-get-id GET /v1/cloud-ml/clusters/{cluster_id}."
        },
        {
          "name": "cloudml-cluster-check-releasable",
          "service": "cloud-ml",
          "method": "GET",
          "path": "/v1/cloud-ml/clusters/{cluster_id}/check-releasable",
          "expect_status": [
            200,
            400,
            403,
            404,
            409,
            422
          ],
          "optional": true,
          "group": "cloud-ml-precond",
          "_note": "id-bound cluster precondition GET — is the cluster releasable for a cloud-ml stack? expect 200; tolerate 4xx. Closes GAP-get-id GET /v1/cloud-ml/clusters/{cluster_id}/check-releasable."
        },
        {
          "name": "cloudml-cluster-estimate",
          "service": "cloud-ml",
          "method": "GET",
          "path": "/v1/cloud-ml/clusters/{cluster_id}/estimate",
          "expect_status": [
            200,
            400,
            403,
            404,
            409,
            422
          ],
          "optional": true,
          "group": "cloud-ml-precond",
          "_note": "id-bound cluster precondition GET — cost/resource estimate for a cloud-ml stack on this cluster. expect 200; tolerate 4xx (may need query params, UNPROVEN). Closes GAP-get-id GET /v1/cloud-ml/clusters/{cluster_id}/estimate."
        },
        {
          "name": "cloudml-check-name-and-domain-duplication",
          "service": "cloud-ml",
          "method": "GET",
          "path": "/v1/cloud-ml/check-duplication",
          "params": {
            "name": "regr-cloudml-{ualpha}",
            "domain_name": "regr-cloudml-{ualpha}"
          },
          "expect_status": [
            200,
            400,
            403,
            404
          ],
          "optional": true,
          "group": "cloud-ml-precond",
          "_note": "GAP 편입 2026-07-08 (ai-ml/cloud-ml/checkduplicationnameanddomainname, 마지막 cloud-ml 전역-read gap — COMPLETENESS-AUDIT-2026-07-08). create-cloud-ml 직전 pre-check: create body의 cloud_ml_name/domain_name과 동일 값(regr-cloudml-{ualpha}) 중복 조회. 쿼리는 docs상 name/domain_name 둘 다 optional('Please use either the name or domain_name query parameter' — 최소 1개 사용). live 2026-07-08: name/domain_name/무쿼리 전 조합 404 (Spring 기본 Not Found) — 쿼리 문제 아님: 같은 계정에서 GET /v1/cloud-ml/images도 404 = knowledge/formal/resources/ai-ml__cloud-ml.yaml의 'SCR-credential-gated — GET /v1/cloud-ml/images 404'와 동일 계정/크리덴셜 게이트 클래스. 따라서 strict 불가 → 관용 [200,400,403,404]+optional (owner 규정: 4xx 조사 후 해결 불가 시 관용+_note). SCR 크리덴셜 활성화 후 이 체인 첫 라이브 런에서 200 확인되면 strict 승급."
        },
        {
          "name": "create-cloud-ml",
          "service": "cloud-ml",
          "method": "POST",
          "path": "/v1/cloud-ml",
          "json": {
            "cloud_ml_name": "regr-cloudml-{ualpha}",
            "description": "API regression suite",
            "cluster_id": "{cluster_id}",
            "image_id": "{image_id}",
            "product_group_id": "{env:SCP_CLOUDML_PRODUCT_GROUP_ID}",
            "domain_name": "regr-cloudml-{ualpha}",
            "endpoint_type": "PUBLIC",
            "custom_registry_host": "{env:SCP_SCR_REGISTRY_HOST}",
            "custom_registry_access_key": "{env:SCP_SCR_ACCESS_KEY}",
            "custom_registry_access_secret_key": "{env:SCP_SCR_ACCESS_SECRET_KEY}",
            "custom_registry_access_project_id": "{env:SCP_SCR_PROJECT_ID}",
            "custom_registry_access_region": "{region}",
            "use_copilot": false,
            "analytics_resource": {
              "cpu": 1,
              "gpu": "",
              "memory": 2
            },
            "application_resource": {
              "cpu": 1,
              "memory": 2
            },
            "copilot": {
              "cpu": 0,
              "gpu": "",
              "memory": 0
            },
            "tags": []
          },
          "_note": "product_group_id + custom_registry_* are owner-fill literals — engine has NO env->body substitution (regression/scenarios/engine.py _fill/_fill_obj resolve only builtins + prior captures), and create-container-registry captures only reg_id, so the console-issued SCR auth key cannot be wired automatically. custom_registry_host/access_key/access_secret_key are documented required (data/validation_findings.json:169-181); product_group_id + custom_registry_access_project_id/access_region appear in data/api_bodies.json createcloudml but are UNPROVEN-required (no doc constraint). custom_registry_access_region defaulted to {region}; remove any field the live API rejects as unknown. This key is a step-level sibling of json (NOT in the body) so the engine never sends it.",
          "expect_status": [
            200,
            201,
            202
          ],
          "group": "cloud-ml",
          "_comment": "SCR 활성화 게이트 (2026-07-08 확정): group 'cloud-ml' 동승 — 감지기(create-cloudml-image)가 404/빈 목록이면 스킵. strict 유지(mutating 관용화 없음 → role=verify 보존); 게이트 해제 후엔 기존과 동일하게 실행.",
          "capture": {
            "cloud_ml_id": "$.id"
          },
          "cleanup": {
            "method": "DELETE",
            "path": "/v1/cloud-ml/{cloud_ml_id}",
            "service": "cloud-ml"
          }
        },
        {
          "name": "verify-cloud-ml",
          "service": "cloud-ml",
          "method": "GET",
          "path": "/v1/cloud-ml/{cloud_ml_id}",
          "expect_status": [
            200
          ],
          "group": "cloud-ml",
          "_note": "SCR 활성화 게이트 (2026-07-08 확정): group 'cloud-ml' 동승 — create 스킵 시 함께 스킵(리터럴 {cloud_ml_id} GET 방지). strict 유지."
        },
        {
          "name": "delete-cloud-ml",
          "service": "cloud-ml",
          "method": "DELETE",
          "path": "/v1/cloud-ml/{cloud_ml_id}",
          "expect_status": [
            200,
            202,
            204
          ],
          "destructive": true,
          "group": "cloud-ml",
          "_note": "SCR 활성화 게이트 (2026-07-08 확정): group 'cloud-ml' 동승 — create가 스킵되면 지울 것도 없으므로 함께 스킵(리터럴 토큰 DELETE 404로 lifecycle을 죽이던 delete-custom-image 교훈과 동일 패턴). strict 유지."
        },
