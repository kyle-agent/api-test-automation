  "lifecycles": [
    {
      "id": "epas-cluster-subops-guarded",
      "service": "database/epas",
      "enabled": true,
      "heavy": true,
      "_note": "COVERAGE-ONLY guarded lifecycle for the epas DBaaS cluster sub-op WRITE endpoints. It does NOT provision a real billable cluster: it soft-captures an EXISTING cluster_id (+ instance_group_id / bsg_id / log_type) from read-only list/show calls; when none exists the {{cluster_id}} (and {{instance_group_id}}/{{bsg_id}}/{{log_type}}/{{origin_cluster_id}}/{{replica_cluster_id}}) tokens still normalize to the catalog '*' key so each endpoint is CALLED and RECORDED (a 404/400/403/409/422 counts as covered per the engine). Every mutating step is optional+grouped+broad-expect_status so an isolated 4xx records coverage WITHOUT failing the run or chaining a real create->mutate->delete. heavy:true gates behind SCP_RUN_HEAVY; DELETEs are destructive:true. Bodies derive from the shared SCP DBaaS shape + per-endpoint api_docs request_example (data/api_bodies.json only has createcluster) and are UNPROVEN — promote to validated after a real 2xx. The relational engines (mysql/mariadb/epas/postgresql) share ONE body template; epas adds audit-log + DELETE /archive.",
      "steps": [
        {
          "name": "list-clusters",
          "method": "GET",
          "path": "/v1/clusters",
          "expect_status": [
            200
          ],
          "capture_soft": {
            "cluster_id": "$.contents[0].id"
          }
        },
        {
          "name": "probe-reads",
