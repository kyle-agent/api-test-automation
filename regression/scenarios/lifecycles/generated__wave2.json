            200
          ],
          "poll": {
            "field": "$.cloud_function.state",
            "until": [
              "READY",
              "RUNNING",
              "ACTIVE",
              "Running"
            ],
            "timeout": 300,
            "interval": 10
          }
        },
        {
          "name": "verify-scf-function-read-codes",
          "service": "scf",
          "method": "GET",
          "path": "/v1/cloud-functions/{cloud_function_id}/codes",
