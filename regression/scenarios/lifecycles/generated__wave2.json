{
  "_comment": "Composed R3 verification wave 2 — vpc-free target chains so the gap_getid verify additions actually execute. Generated by regression/scenarios/composer.py.",
  "lifecycles": [
    {
      "id": "gen-wave2-sec",
      "service": "security/kms",
      "enabled": true,
      "_note": "composed verification wave 2 — vpc-free chains carrying the new id-bound GET verifies (docs/working/plans/COVERAGE-GETID-PLAN.md); targets: kms-key, secret",
      "steps": [
        {
          "name": "create-kms-key",
          "service": "kms",
          "method": "POST",
          "path": "/v1/kms/transit",
          "json": {
            "auto_rotate": "Y",
            "description": "API regression suite",
            "key_type": "advanced",
            "name": "regrkms{unique}",
            "purpose": "rsa-2048",
            "rotate_cycle": 7,
            "tags": []
          },
          "expect_status": [
            200,
            201,
            202
          ],
          "capture": {
            "key_id": "$.key.id"
          },
          "cleanup": {
            "method": "DELETE",
            "path": "/v1/kms/transit/{key_id}",
            "service": "kms"
          }
        },
        {
          "name": "verify-kms-key-read-users",
          "service": "kms",
          "method": "GET",
          "path": "/v1/kms/transit/{key_id}/users",
          "expect_status": [
            200
          ],
          "group": "kms-key"
        },
        {
          "name": "create-secret",
          "service": "secretsmanager",
          "method": "POST",
          "path": "/v1/secrets",
          "json": {
            "acl_cidr": "10.0.0.0/25",
            "description": "API regression suite",
            "kms_id": "{key_id}",
            "name": "regrsec{unique}",
            "private_acl_enabled": "false",
            "private_acl_resources": [],
            "secret_value": "{\"k\":\"v\"}",
            "tags": []
          },
          "expect_status": [
            200,
            201,
            202
          ],
          "capture": {
            "secret_id": "$.secret.id"
          },
          "cleanup": {
            "method": "DELETE",
            "path": "/v1/secrets/{secret_id}",
            "json": {
              "waiting_time_ndays": 7
            },
            "service": "secretsmanager"
          }
        },
        {
          "name": "verify-secret-read-versions",
          "service": "secretsmanager",
          "method": "GET",
          "path": "/v1/secrets/{secret_id}/versions",
          "expect_status": [
            200
          ],
          "group": "secret"
        },
        {
          "name": "delete-secret",
          "service": "secretsmanager",
          "method": "DELETE",
          "path": "/v1/secrets/{secret_id}",
          "expect_status": [
            200,
            202,
            204
          ],
          "destructive": true,
          "json": {
            "waiting_time_ndays": 7
          }
        },
        {
          "name": "delete-kms-key",
          "service": "kms",
          "method": "DELETE",
          "path": "/v1/kms/transit/{key_id}",
          "expect_status": [
            200,
            202,
            204,
            409,
            404
          ],
          "destructive": true,
          "retry_on_status": [
            409
          ],
          "retries": 40,
          "retry_interval": 30
        }
      ]
    },
    {
      "id": "gen-wave2-scf",
      "service": "compute/scf",
      "enabled": true,
      "_note": "recomposed after run 27417986669 triage (interface port-only, trigger cron, fs volume_id, private-acl deferred) | 2026-07-08 완전성 GAP 편입 (COMPLETENESS-AUDIT-2026-07-08): scf의 마지막 3개 (a)-class 전역 GET(listruntimes, listsamplecodes, checkfunctionnameduplication)을 create 앞 lookup/pre-check 스텝으로 흡수 — scf catalog 36/36 시나리오 커버.",
      "steps": [
        {
          "name": "list-scf-runtimes",
          "service": "scf",
          "method": "GET",
          "path": "/v1/cloud-functions/runtimes",
          "expect_status": [
            200
          ],
