        },
        {
          "name": "create-scf-function",
          "service": "scf",
          "method": "POST",
          "path": "/v1/cloud-functions",
          "json": {
            "name": "regrscf{unique}",
            "runtime": "Node.js:20",
            "content": "exports.handler = async () => ({ statusCode: 200, body: 'regr' });",
            "tags": []
