          "method": "POST",
          "path": "/v1/clusters",
          "json": {
            "name": "regrdbvu{ualpha}",
            "instance_name_prefix": "regrdbvu",
            "dbaas_engine_version_id": "{engine_version_old_id}",
            "ha_enabled": false,
