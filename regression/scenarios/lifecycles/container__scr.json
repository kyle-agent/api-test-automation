                "name": "test"
              },
              "get": "id"
            }
          }
        },
        {
          "name": "list-repositories-harvest",
          "method": "GET",
          "path": "/v1/repositories",
          "expect_status": [
            200,
            400,
            403,
            404
          ],
          "optional": true,
