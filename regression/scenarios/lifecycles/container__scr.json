{
  "lifecycles": [
    {
      "id": "scr-repo-borrow-coverage",
      "service": "container/scr",
      "enabled": true,
      "heavy": false,
      "_note": "LIVE-PROVEN 2026-06-24. Borrows the existing account registry (quota=1, slot occupied) by listing registries and capturing registry_id, then creates a uniquely-named temporary repository on it to cover all 7 repo-CRUD endpoints (createrepository/updaterepositorydescription/updaterepositorylockpolicy/updaterepositorypullpolicy/updaterepositoryscanpolicy/updaterepositorylifecyclepolicy/deleterepository) + 3 registry-ACL PUTs (updateprivateacl/updatepublicacl/updatepublicendpointenabled) in a single non-VPC run. All ACL PUTs use safe idempotent no-op values (disabled=false, empty resource lists). Teardown: DELETE /v1/repositories/{repo_id} confirmed 202. No registry create/delete needed. NOT gated on SCP_RUN_HEAVY (non-billable).",
      "steps": [
        {
          "name": "list-registries-borrow",
          "method": "GET",
          "path": "/v1/container-registries",
          "expect_status": [
            200
          ],
          "capture": {
            "registry_id": "$.registries[0].id"
          }
        },
        {
          "name": "create-repo",
          "method": "POST",
          "path": "/v1/repositories",
          "json": {
            "name": "regrscr{unique}",
            "description": "API regression suite",
            "registry_id": "{registry_id}",
            "lifecycle_policy": {
              "lifecycle_policy_enabled": false,
              "outdated_rule_enabled": false,
              "outdated_rule_duration": 90,
              "outdated_rule_tag_expression": "*",
              "untagged_rule_enabled": false,
              "untagged_rule_duration": 90
            },
            "lock_policy": {
              "locked": false
            },
            "pull_policy": {
              "critical_limit": 0,
              "high_limit": 0,
              "unmodified_excepted": false,
              "unscanned_image_pull_prevented": false,
              "vulnerable_image_pull_prevented": false
            },
            "scan_policy": {
              "auto_scan_enabled": false,
              "fixed_version_excepted": false,
              "language_excepted": false,
              "scan_policy_enabled": false,
              "secret_excepted": false,
              "severity_limit": "High"
            },
            "tags": []
          },
          "expect_status": [
            200,
            201,
            202
          ],
          "capture": {
            "repo_id": "$.id"
          },
          "cleanup": {
            "method": "DELETE",
            "path": "/v1/repositories/{repo_id}",
            "service": "scr"
          }
        },
        {
          "name": "repo-update-description",
          "method": "PUT",
          "path": "/v1/repositories/{repo_id}/description",
          "json": {
            "description": "API regression suite (updated)"
          },
          "expect_status": [
            200,
            202,
            204
          ],
          "optional": true,
          "group": "scr-repo-puts"
        },
        {
          "name": "repo-update-lock-policy",
          "method": "PUT",
          "path": "/v1/repositories/{repo_id}/lock-policy",
          "json": {
            "lock_policy": {
              "locked": false
            }
          },
          "expect_status": [
            200,
            202,
            204
          ],
          "optional": true,
          "group": "scr-repo-puts"
        },
        {
          "name": "repo-update-pull-policy",
          "method": "PUT",
          "path": "/v1/repositories/{repo_id}/pull-policy",
          "json": {
            "pull_policy": {
              "critical_limit": 0,
              "high_limit": 0,
              "unmodified_excepted": false,
              "unscanned_image_pull_prevented": false,
              "vulnerable_image_pull_prevented": false
            }
          },
          "expect_status": [
            200,
            202,
            204
          ],
          "optional": true,
          "group": "scr-repo-puts"
        },
        {
          "name": "repo-update-scan-policy",
          "method": "PUT",
          "path": "/v1/repositories/{repo_id}/scan-policy",
          "json": {
            "scan_policy": {
              "auto_scan_enabled": false,
              "fixed_version_excepted": false,
              "language_excepted": false,
              "scan_policy_enabled": false,
              "secret_excepted": false,
              "severity_limit": "High"
            }
          },
          "expect_status": [
            200,
            202,
            204
          ],
          "optional": true,
          "group": "scr-repo-puts"
        },
        {
          "name": "repo-update-lifecycle-policy",
          "method": "PUT",
          "path": "/v1/repositories/{repo_id}/lifecycle-policy",
          "json": {
            "lifecycle_policy": {
              "lifecycle_policy_enabled": false,
              "outdated_rule_enabled": false,
              "outdated_rule_duration": 90,
              "outdated_rule_tag_expression": "*",
              "untagged_rule_enabled": false,
              "untagged_rule_duration": 90
            }
          },
          "expect_status": [
            200,
            202,
            204
          ],
          "optional": true,
          "group": "scr-repo-puts"
        },
        {
          "name": "registry-update-private-acl",
          "method": "PUT",
          "path": "/v1/container-registries/{registry_id}/private-acl",
          "json": {
            "private_acl_enabled": false,
            "private_acl_resources": []
          },
          "expect_status": [
            200,
            202,
            204
          ],
          "optional": true,
          "group": "scr-registry-private-acl",
          "_note": "private-acl can be set without public endpoint enabled"
        },
        {
          "name": "registry-enable-public-endpoint",
          "method": "PUT",
          "path": "/v1/container-registries/{registry_id}/enable-public-endpoint",
          "json": {
            "public_endpoint_enabled": true
          },
          "expect_status": [
            200,
            201,
            202,
            204
          ],
          "optional": true,
          "group": "scr-registry-public-endpoint",
          "_note": "updatepublicendpointenabled: enable public endpoint first so public-acl can be set (409 otherwise)"
        },
        {
          "name": "registry-update-public-acl",
          "method": "PUT",
          "path": "/v1/container-registries/{registry_id}/public-acl",
          "json": {
            "public_acl_enabled": false,
            "public_acl_resources": []
          },
          "expect_status": [
            200,
            202,
            204
          ],
          "optional": true,
          "group": "scr-registry-public-acl",
          "_note": "updatepublicacl: requires public endpoint enabled first; using public_acl_enabled:false (no-op/safe) || auto-repair R1-settle-409 (run-end 자동수리): 409 settle 서명 ({\"errors\":[{\"code\":\"scp-container-registry.common.edit-conflict\",\"detail\":\"Resou…) — retry_on_status에 409 없음",
          "retry_on_status": [
            409
          ],
          "retries": 8,
          "retry_interval": 15
        },
        {
          "name": "registry-disable-public-endpoint",
          "method": "PUT",
          "path": "/v1/container-registries/{registry_id}/enable-public-endpoint",
          "json": {
            "public_endpoint_enabled": false
          },
          "expect_status": [
            200,
            201,
            202,
            204
          ],
          "optional": true,
          "group": "scr-registry-disable-pe",
          "_note": "restore public endpoint to disabled (default state of sample registry)"
        },
        {
          "name": "probe-reads",
          "probe_reads": {
            "registry_id": "{registry_id}",
            "repository_id": "{repo_id}"
          }
        },
        {
          "name": "delete-repo",
          "method": "DELETE",
          "path": "/v1/repositories/{repo_id}",
          "expect_status": [
            200,
            202,
            204
          ],
          "destructive": true,
          "retry_on_status": [
            409,
            500
          ],
          "retries": 3,
          "retry_interval": 10
        }
      ]
    },
    {
      "id": "scr-image-write-coverage",
      "service": "container/scr",
      "enabled": true,
      "_note": "COVERAGE-ONLY (reaches image write endpoints so they are RECORDED, even though they 4xx with no real image). SCR image ids are born by docker push, not REST POST. Seeds registry_id via GET /v1/container-registries (200 confirmed), then repository_id via GET /v1/container-registries/{registry_id}/repositories (200), then image_id via soft-capture against GET /v1/repositories/{repository_id}/images (empty => placeholder stays LITERAL => guaranteed 404 on write steps). CALLS every image write endpoint once; each fires and records under its catalog key regardless of status. Each write is optional+isolated group+broad expect_status [200..422] so nothing reds the run. Light/non-billable (no resource created). LIVE-VERIFIED 2026-06-24: seed steps confirmed 200; write steps reach the API and record 4xx (needs-docker-push blocker).",
