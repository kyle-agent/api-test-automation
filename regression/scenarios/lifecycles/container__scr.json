        {
          "name": "seed-registry-id",
          "method": "GET",
          "path": "/v1/container-registries",
          "expect_status": [
            200,
            400,
            403,
            404
          ],
          "optional": true,
          "capture_soft": {
            "registry_id": {
              "list": "$.registries",
              "where_prefix": {
