    {
      "id": "gen-alert",
      "service": "management/servicewatch",
      "enabled": true,
      "_note": "composed by regression/scenarios/composer.py — targets: alert. create/set-alert carry a real dimension {key,value} captured from the metric catalog ($.namespaces[0].dimensions[0].metrics[0].dimensions[0]) — live 400 'At least one dimension must be set.' otherwise (DimensionDTO required at runtime though docs mark dimension/dimensions optional).",
      "steps": [
        {
          "name": "create-sw-metric-catalog",
          "service": "servicewatch",
          "method": "POST",
          "path": "/v1/metrics",
          "json": {},
          "expect_status": [
            200,
            201,
            202
          ],
          "capture": {
            "namespace_id": "$.namespaces[0].id",
            "namespace_name": "$.namespaces[0].name",
            "metric_id": "$.namespaces[0].dimensions[0].metrics[0].id",
            "metric_name": "$.namespaces[0].dimensions[0].metrics[0].name",
            "dim_key": "$.namespaces[0].dimensions[0].metrics[0].dimensions[0].key",
            "dim_value": "$.namespaces[0].dimensions[0].metrics[0].dimensions[0].value"
          }
        },
        {
          "name": "create-alert",
          "service": "servicewatch",
          "method": "POST",
          "path": "/v1/alerts",
          "json": {
            "description": "regr alert {unique}",
            "dimension": {
              "key": "{dim_key}",
              "value": "{dim_value}"
            },
            "evaluation_count": 3,
            "level": "HIGH",
            "lower_bound": 80.0,
            "metric_id": "{metric_id}",
            "missing_data_option": "BREACHING",
            "name": "regralert{unique}",
            "namespace_id": "{namespace_id}",
            "operator": "RANGE",
            "period": 300,
            "recipient_ids": [],
            "statistic": "AVG",
            "tags": [],
            "upper_bound": 90.0,
            "violation_count": 2
          },
          "expect_status": [
            200,
            201,
            202
          ],
          "capture": {
            "alert_id": "$.id"
          },
          "cleanup": {
            "method": "DELETE",
            "path": "/v1/alerts",
            "json": {
              "ids": [
                "{alert_id}"
              ]
            },
            "service": "servicewatch"
          }
        },
        {
          "name": "verify-alert-read",
          "service": "servicewatch",
          "method": "GET",
          "path": "/v1/alerts/{alert_id}",
          "expect_status": [
            200
          ]
        },
        {
          "name": "verify-alert-set",
          "service": "servicewatch",
          "method": "PATCH",
          "path": "/v1/alerts/{alert_id}",
          "json": {
            "dimension": {
              "key": "{dim_key}",
              "value": "{dim_value}"
            },
            "evaluation_count": 3,
            "level": "HIGH",
            "lower_bound": 80.0,
            "metric_id": "{metric_id}",
            "missing_data_option": "BREACHING",
            "namespace_id": "{namespace_id}",
            "operator": "RANGE",
            "period": 300,
            "statistic": "AVG",
            "upper_bound": 90.0,
            "violation_count": 2
          },
          "expect_status": [
            200
          ]
        },
        {
          "name": "verify-alert-set-activated",
          "service": "servicewatch",
          "method": "PATCH",
          "path": "/v1/alerts/{alert_id}/activated",
          "json": {
            "activated_yn": "N"
          },
          "expect_status": [
            200
          ]
        },
        {
          "name": "verify-alert-set-description",
          "service": "servicewatch",
          "method": "PATCH",
          "path": "/v1/alerts/{alert_id}/description",
          "json": {
            "description": "regr alert {unique} updated"
          },
          "expect_status": [
            200
          ]
        },
        {
          "name": "delete-alert",
          "service": "servicewatch",
          "method": "DELETE",
          "path": "/v1/alerts",
          "expect_status": [
            200,
            202,
            204
          ],
          "destructive": true,
          "json": {
            "ids": [
              "{alert_id}"
            ]
          }
        }
      ]
    },
    {
      "id": "gen-cm-account-resource",
