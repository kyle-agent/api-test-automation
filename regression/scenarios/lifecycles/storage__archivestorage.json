            404
          ],
          "_note": "reachability-only id-bound GET (owner): access-tested off bucket_id, 4xx tolerated incl 401 (no archivestorage dedicated auth key → 401 is the expected reachability response, run 27725293499)"
        },
        {
          "name": "show-bucket-object-versions",
