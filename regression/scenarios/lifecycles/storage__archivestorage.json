          "method": "PUT",
          "path": "/v1/buckets/{bucket_id}/recover-object-versions",
          "group": "as-recover-object-versions",
          "optional": true,
          "json": {
            "recovery_target_bucket_name": "regras{unique}",
            "source_object_path": "/",
            "source_object_version": "Oc9nEYWV.6VjzsIMXFZWM1zL8HcYvKl",
            "overwrite": true
          },
          "expect_status": [
            200,
            201,
            202,
            400,
            403,
            404,
            409,
            422
          ]
        },
        {
          "name": "delete-bucket-objects",
          "method": "DELETE",
          "path": "/v1/buckets/{bucket_id}/objects",
          "group": "as-delete-objects",
          "optional": true,
          "destructive": true,
          "json": {
            "paths": [
              "test/"
            ]
          },
          "expect_status": [
            200,
            202,
            204,
            400,
            403,
            404,
            409,
            422
          ]
        },
        {
          "name": "delete-bucket-object-versions",
          "method": "DELETE",
          "path": "/v1/buckets/{bucket_id}/object-versions",
          "group": "as-delete-object-versions",
          "optional": true,
          "destructive": true,
          "json": {
            "path": "hello/my_file.txt",
            "versions": [
              "Oc9nEYWV.6VjzsIMXFZWM1zL8HcYvKl"
            ]
          },
          "expect_status": [
            200,
            202,
            204,
            400,
            403,
            404,
            409,
            422
          ]
        },
        {
          "name": "probe-reads",
          "probe_reads": {
            "bucket_id": "{bucket_id}"
          }
        },
        {
          "name": "delete-bucket",
          "method": "DELETE",
          "path": "/v1/buckets/{bucket_id}",
          "optional": true,
          "destructive": true,
          "expect_status": [
            200,
            202,
            204,
            404,
            409
          ],
          "retry_on_status": [
            409,
            500
          ],
          "retries": 4,
          "retry_interval": 15
        },
        {
          "name": "wait-bucket-gone",
          "method": "GET",
          "path": "/v1/buckets/{bucket_id}",
          "optional": true,
          "expect_status": [
            200,
            404
          ],
          "poll": {
            "until_status": [
              404
            ],
            "timeout": 300,
            "interval": 15
          }
        }
      ]
    },
