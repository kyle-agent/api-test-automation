{
  "lifecycles": [
    {
      "id": "networking-gslb-service",
      "service": "networking/gslb",
      "enabled": true,
      "heavy": false,
      "_note": "GSLB CRUD — LIVE-VALIDATED 2026-06-23 (10/10 endpoints 2xx). All 6 write ops + 4 read ops confirmed. Key facts proven live: (1) health_check_interval must be < timeout (e.g. 5 < 10); (2) health_check_probe_timeout must be 5-300 (use 5); (3) resources array must have at least 1 entry at create time; (4) resources[].region uses DASH format 'kr-west-1' NOT 'kr-west1'; (5) create/set-health-check/set-resources/set-routing-control all return 202 (ASYNC) — each leaves GSLB in EDITING state; must poll GET /v1/gslbs/{id} until $.gslb.state=ACTIVE before next SET; delete requires ACTIVE/ERROR state. Wait steps inserted between async ops. REGION GATE: GSLB only in kr-west1/kr-east1 — on a kr-south profile this lifecycle must be disabled. Status: all 10 catalog endpoints covered.",
      "steps": [
        {
          "name": "create-gslb",
          "method": "POST",
          "path": "/v1/gslbs",
          "group": "gslb",
          "optional": true,
          "json": {
            "algorithm": "ROUND_ROBIN",
            "description": "API regression suite",
            "env_usage": "PUBLIC",
            "health_check": {
              "health_check_interval": "5",
              "health_check_probe_timeout": "5",
              "health_check_user_id": "",
              "health_check_user_password": "",
              "protocol": "TCP",
              "receive_string": "",
              "send_string": "",
              "service_port": "80",
              "timeout": "10"
            },
            "name": "regr{ualpha}.gslb.e.samsungsdscloud.com",
            "resources": [
              {
                "description": "API regression suite resource",
                "destination": "192.0.2.10",
                "region": "kr-west-1",
                "weight": 0
              }
            ],
            "tags": []
          },
          "expect_status": [200, 201, 202, 400, 403, 404, 409, 422],
          "_provenance": "VALIDATED 2026-06-23 live 202",
          "capture_soft": {"gslb_id": "$.gslb.id"},
          "cleanup": {
            "method": "DELETE",
            "path": "/v1/gslbs/{gslb_id}",
            "service": "gslb"
          }
        },
        {
          "name": "wait-gslb-active",
          "method": "GET",
          "path": "/v1/gslbs/{gslb_id}",
          "group": "gslb",
          "optional": true,
          "expect_status": [200, 400, 403, 404],
          "poll": {
            "field": "$.gslb.state",
            "until": ["ACTIVE", "ERROR"],
            "timeout": 120,
            "interval": 5
          },
          "_note": "GSLB create returns 202 (async). Poll until state=ACTIVE before attempting SET operations. Validated live: CREATING -> ACTIVE typically in <10s."
        },
        {
          "name": "get-gslb",
          "method": "GET",
          "path": "/v1/gslbs/{gslb_id}",
          "group": "gslb",
          "optional": true,
          "expect_status": [200, 400, 403, 404]
        },
        {
          "name": "set-gslb",
          "method": "PUT",
          "path": "/v1/gslbs/{gslb_id}",
          "group": "gslb",
          "optional": true,
          "json": {
            "algorithm": "ROUND_ROBIN",
            "description": "API regression suite (updated)"
          },
          "expect_status": [200, 201, 202, 400, 403, 404, 409, 422]
        },
        {
          "name": "set-gslb-health-check",
          "method": "PUT",
          "path": "/v1/gslbs/{gslb_id}/health-check",
          "group": "gslb",
          "optional": true,
          "json": {
            "health_check_interval": "5",
            "health_check_probe_timeout": "5",
            "health_check_user_id": "",
            "health_check_user_password": "",
            "protocol": "TCP",
            "receive_string": "",
            "send_string": "",
            "service_port": "80",
            "timeout": "10"
          },
          "expect_status": [200, 201, 202, 400, 403, 404, 409, 422]
        },
        {
          "name": "wait-gslb-after-health-check",
          "method": "GET",
          "path": "/v1/gslbs/{gslb_id}",
          "group": "gslb",
          "optional": true,
          "expect_status": [200, 400, 403, 404],
          "poll": {
            "field": "$.gslb.state",
            "until": ["ACTIVE", "ERROR"],
            "timeout": 120,
            "interval": 5
          },
          "_note": "set-gslb-health-check returns 202 (async EDITING->ACTIVE). Wait before set-resources which requires ACTIVE state."
        },
        {
          "name": "set-gslb-resources",
          "method": "PUT",
          "path": "/v1/gslbs/{gslb_id}/resources",
          "group": "gslb",
          "optional": true,
          "json": {
            "resources": [
              {
                "description": "API regression suite",
                "destination": "192.0.2.10",
                "region": "kr-west-1",
                "weight": 0
              }
            ]
          },
          "expect_status": [200, 201, 202, 400, 403, 404, 409, 422]
        },
        {
          "name": "wait-gslb-after-resources",
          "method": "GET",
          "path": "/v1/gslbs/{gslb_id}",
          "group": "gslb",
          "optional": true,
          "expect_status": [200, 400, 403, 404],
          "poll": {
            "field": "$.gslb.state",
            "until": ["ACTIVE", "ERROR"],
            "timeout": 120,
            "interval": 5
          },
          "_note": "set-gslb-resources may be async (EDITING->ACTIVE). Wait before set-routing-control which requires ACTIVE state."
        },
        {
          "name": "set-gslb-routing-control",
          "method": "PUT",
          "path": "/v1/gslbs/{gslb_id}/routing-control",
          "group": "gslb",
          "optional": true,
          "json": {
            "region": "kr-west-1",
            "status": "ENABLE"
          },
          "expect_status": [200, 201, 202, 400, 403, 404, 409, 422]
        },
        {
          "name": "get-gslb-resources",
          "method": "GET",
          "path": "/v1/gslbs/{gslb_id}/resources",
          "group": "gslb",
          "optional": true,
          "expect_status": [200, 400, 403, 404],
          "_note": "id-bound read of the gslb's connected resources (listgslbresources). Closes the gslb_id getid GET /v1/gslbs/{gslb_id}/resources. Keys off the create-captured gslb_id; tolerant [200,400,403,404] because on a 4xx create the id stays a placeholder (normalizes to the catalog '*' key, still records coverage). Complements the runtime probe-gslb-reads below — this explicit step also makes the endpoint statically reachable in a LIGHT run."
        },
        {
          "name": "probe-gslb-reads",
          "probe_reads": {"gslb_id": "{gslb_id}"}
        },
        {
          "name": "wait-gslb-deletable",
          "method": "GET",
          "path": "/v1/gslbs/{gslb_id}",
          "group": "gslb",
          "optional": true,
          "expect_status": [200, 400, 403, 404],
          "poll": {
            "field": "$.gslb.state",
            "until": ["ACTIVE", "ERROR"],
            "timeout": 120,
            "interval": 5
          },
          "_note": "GSLB set operations (PUT) may leave resource in EDITING state. Wait for ACTIVE/ERROR before DELETE, which requires those states."
        },
        {
          "name": "delete-gslb",
          "method": "DELETE",
          "path": "/v1/gslbs/{gslb_id}",
          "group": "gslb",
          "optional": true,
          "destructive": true,
          "expect_status": [200, 202, 204, 400, 403, 404, 409]
        }
      ]
    }
  ]
}
