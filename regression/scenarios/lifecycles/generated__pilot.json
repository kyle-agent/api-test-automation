{
  "lifecycles": [
    {
      "id": "gen-pilot-net-basics",
      "service": "networking/vpc",
      "enabled": true,
      "_note": "recomposed 2026-06-13 — vpc add-cidr + igw list/set verifies added (retirement NEAR gaps; vpc-cidr-secondary/-internet-gateway hand-written chains retire after this goes green)",
      "steps": [
        {
          "name": "create-vpc",
          "service": "vpc",
          "method": "POST",
          "path": "/v1/vpcs",
          "json": {
            "name": "regrvpc{unique}",
            "description": "API regression suite",
            "cidr": "10.160.0.0/20",
            "tags": []
          },
          "expect_status": [
            200,
            201,
            202
          ],
          "capture": {
            "vpc_id": "$.vpc.id"
          },
          "cleanup": {
            "method": "DELETE",
            "path": "/v1/vpcs/{vpc_id}",
            "service": "vpc"
          },
          "adopt": "vpc"
        },
        {
          "name": "wait-vpc",
          "service": "vpc",
          "method": "GET",
          "path": "/v1/vpcs/{vpc_id}",
          "expect_status": [
            200
          ],
          "poll": {
            "field": "$.vpc.state",
            "until": [
              "ACTIVE"
            ],
            "timeout": 180,
            "interval": 10
          }
        },
        {
          "name": "verify-vpc-add-cidr",
          "service": "vpc",
          "method": "POST",
          "path": "/v1/vpcs/{vpc_id}/cidrs",
          "json": {
            "cidr": "10.200.0.0/20"
          },
          "expect_status": [
            200,
            201,
            202
          ],
          "group": "vpc",
          "_note": "수작업 vpc-cidr-secondary 은퇴 갭: addvpccidr. 수작업은 [200..422] 관용이라 UNPROVEN이었음 — 하드 기대. 보조 CIDR은 표준 DELETE가 없어 VPC 삭제로 함께 제거"
        },
        {
          "name": "verify-vpc-set",
          "service": "vpc",
          "method": "PUT",
          "path": "/v1/vpcs/{vpc_id}",
          "optional": true,
          "json": {
            "description": "updated by API regression suite"
          },
          "expect_status": [
            200,
            201,
            202,
            400,
            403,
            404,
            409,
            422
          ],
          "_note": "2026-07-08 DEDUP 이관(owner GO, DEDUP-AUDIT-2026-07-08): vpc-cidr-secondary 은퇴분 (setvpc). optional+관용 — VPC 상태에 따른 4xx 도 기록은 남긴다 (원 스텝 노트 승계)."
        },
        {
          "name": "create-subnet",
          "service": "vpc",
          "method": "POST",
          "path": "/v1/subnets",
          "json": {
            "name": "regrsub{unique}",
            "description": "API regression suite",
            "cidr": "10.160.8.0/24",
            "type": "PUBLIC",
            "category": "PRIMARY",
            "vpc_id": "{vpc_id}",
            "tags": []
          },
          "expect_status": [
            200,
            201,
            202
          ],
          "capture": {
            "subnet_id": "$.subnet.id"
          },
          "cleanup": {
            "method": "DELETE",
            "path": "/v1/subnets/{subnet_id}",
            "service": "vpc"
          },
          "adopt": "subnet"
        },
        {
          "name": "wait-subnet",
          "service": "vpc",
          "method": "GET",
          "path": "/v1/subnets/{subnet_id}",
          "expect_status": [
            200
          ],
          "poll": {
            "field": "$.subnet.state",
            "until": [
              "ACTIVE"
            ],
            "timeout": 600,
            "interval": 10
          }
        },
        {
          "name": "verify-subnet-read-vips",
          "service": "vpc",
          "method": "GET",
          "path": "/v1/subnets/{subnet_id}/vips",
          "expect_status": [
            200
          ],
          "group": "subnet"
        },
        {
          "name": "verify-subnet-read-sap-secondary-subnets",
          "service": "vpc",
          "method": "GET",
          "path": "/v1/subnets/{subnet_id}/sap-secondary-subnets",
          "expect_status": [
            200
          ],
          "group": "subnet"
        },
        {
          "name": "create-port",
          "service": "vpc",
          "method": "POST",
          "path": "/v1/ports",
          "json": {
            "name": "regrport{unique}",
            "description": "API regression suite",
            "security_groups": [],
            "subnet_id": "{subnet_id}",
            "tags": []
          },
          "expect_status": [
            200,
            201,
            202
          ],
          "capture": {
            "port_id": "$.port.id"
          },
          "cleanup": {
            "method": "DELETE",
            "path": "/v1/ports/{port_id}",
            "service": "vpc"
          }
        },
        {
          "name": "wait-port",
          "service": "vpc",
          "method": "GET",
          "path": "/v1/ports/{port_id}",
          "expect_status": [
            200
          ],
          "poll": {
            "field": "$.port.state",
            "until": [
              "ACTIVE",
              "CREATED",
              "RUNNING",
              "DOWN"
            ],
            "timeout": 180,
            "interval": 10
          }
        },
        {
          "name": "verify-port",
          "service": "vpc",
          "method": "GET",
          "path": "/v1/ports/{port_id}",
          "expect_status": [
            200
          ],
          "group": "port"
        },
        {
          "name": "verify-port-set",
          "service": "vpc",
          "method": "PUT",
          "path": "/v1/ports/{port_id}",
          "optional": true,
          "json": {
            "description": "updated by API regression suite",
            "security_groups": []
          },
          "expect_status": [
            200,
            201,
            202,
            400,
            403,
            404,
            409,
            422
          ],
          "_note": "2026-07-08 DEDUP 이관(owner GO, DEDUP-AUDIT-2026-07-08): vpc-port 은퇴분 (setport)."
        },
        {
          "name": "list-ports",
          "service": "vpc",
          "method": "GET",
          "path": "/v1/ports",
          "expect_status": [
            200
          ],
          "params": {},
          "_note": "2026-07-08 완전성 편입(COMPLETENESS-AUDIT-2026-07-08, vpc gap listports): 전역 bare list — live 200 2026-07-08 (빈 목록 200도 실검증). 전역 read라 group 없음(port 그룹 실패와 무관하게 실행). params:{} forces catalog-key recording (engine only records GET catalog key when params present)."
        },
        {
          "name": "list-nat-gateways",
          "service": "vpc",
          "method": "GET",
          "path": "/v1/nat-gateways",
          "expect_status": [
            200
          ],
          "params": {},
          "_note": "2026-07-08 완전성 편입(COMPLETENESS-AUDIT-2026-07-08, vpc gap listnatgateways): 전역 bare list — live 200 2026-07-08 (빈 목록 200도 실검증). 이 lifecycle은 NAT를 만들지 않지만 전역 read라 부모 불필요(감사 host 제안: gen-pilot-net-basics, light). group 없음. params:{} forces catalog-key recording (engine only records GET catalog key when params present)."
        },
        {
          "name": "create-internet-gateway",
          "adopt": "igw",
          "service": "vpc",
          "method": "POST",
          "path": "/v1/internet-gateways",
          "json": {
            "description": "API regression suite",
            "firewall_enabled": false,
            "firewall_loggable": false,
            "type": "IGW",
            "vpc_id": "{vpc_id}",
            "tags": []
          },
          "expect_status": [
            200,
            201,
            202,
            400
          ],
          "optional": true,
          "group": "internet-gateway",
          "capture": {
            "internet_gateway_id": "$.internet_gateway.id"
          },
          "cleanup": {
            "method": "DELETE",
            "path": "/v1/internet-gateways/{internet_gateway_id}",
            "service": "vpc"
          },
          "_note": "2026-07-08 전런 수리 — find-or-tolerate: IGW는 VPC당 1개 싱글톤이라 공유 VPC에서 병렬 체인이 선점하면 400 'already associated with an Internet Gateway' (전런 동시성이 첫 노출). 400 허용 + hard capture 유지가 감지기: 400이면 id capture miss → optional이라 group 'internet-gateway' 실패 → 같은 그룹의 verify-list/verify-set(PUT)/delete-internet-gateway가 함께 스킵. 의미: 이 체인은 자기가 만든 IGW만 수정/삭제하고, 이미 있던(남의) IGW는 절대 지우지 않는다 (capture를 soft로 낮추면 400에도 그룹이 안 죽어 남의 IGW를 지우게 되므로 hard 유지가 필수). 직후 find-internet-gateway(그룹 밖 read)가 실 id를 capture_soft 보충 → wait는 양 경로 모두 실 id로 동작."
        },
        {
          "name": "find-internet-gateway",
          "service": "vpc",
          "method": "GET",
          "path": "/v1/internet-gateways",
          "params": {
            "vpc_id": "{vpc_id}"
          },
          "expect_status": [
            200
          ],
          "optional": true,
          "capture_soft": {
            "internet_gateway_id": "$.internet_gateways[0].id"
          },
          "_note": "find-or-tolerate의 find쪽 (그룹 밖 — create 400시에도 실행되는 순수 read): vpc_id 서버측 필터로 이 VPC의 IGW id를 capture_soft 보충. LIVE 검증 2026-07-08: GET /v1/internet-gateways?vpc_id=<id> → 200 {count,internet_gateways:[{id,state,vpc_id,...}]}, 실 vpc_id로 count=1 필터 확인(가짜 id는 count=0), capture 경로 $.internet_gateways[0].id 확인. params 명시로 catalog key(listinternetgateways) 기록 유지 — create 400시 verify-internet-gateway-list가 그룹 스킵돼도 이 read가 그 커버리지를 대신한다. 이 id는 관찰(wait)용 — 삭제/수정은 그룹(자기 생성시에만)이 담당."
        },
        {
          "name": "wait-internet-gateway",
          "service": "vpc",
          "method": "GET",
          "path": "/v1/internet-gateways/{internet_gateway_id}",
          "expect_status": [
            200,
            404
          ],
          "poll": {
            "field": "$.internet_gateway.state",
            "until": [
              "ACTIVE",
              "ATTACHED",
              "CREATED",
              "RUNNING"
            ],
            "give_up_status": [
              404
            ],
            "timeout": 300,
            "interval": 15
          },
          "_note": "2026-07-08 find-or-tolerate 동반 수리: create 400 경로에선 이 id가 선점한 다른 체인 소유라 폴 중 삭제될 수 있고, find가 빈손이면 리터럴 토큰 GET이 된다 — 404 give_up+허용으로 5분 타임아웃 소진/경성 실패 방지. 자기 생성 happy path에선 삭제 전이라 404가 나올 수 없어 기존 동작과 동일."
        },
        {
          "name": "verify-internet-gateway-list",
          "service": "vpc",
          "method": "GET",
          "path": "/v1/internet-gateways?vpc_id={vpc_id}",
          "expect_status": [
            200
          ],
          "group": "internet-gateway"
        },
        {
          "name": "verify-internet-gateway-set",
          "adopt": "igw",
          "service": "vpc",
          "method": "PUT",
          "path": "/v1/internet-gateways/{internet_gateway_id}",
          "json": {
            "description": "API regression suite (updated)"
          },
          "expect_status": [
            200,
            202
          ],
          "group": "internet-gateway",
          "_note": "수작업 체인 은퇴 갭: listinternetgateways + setinternetgateway (set body는 description-only 추정 — 라이브 본문이 정정)"
        },
        {
          "name": "create-public-ip",
          "service": "vpc",
          "_note": "SPEC BUMP 2026-07-15 (PublicIpCreateRequestV1Dot3): zone 신규 REQUIRED. zone=kr-west1-b LIVE VALIDATED 2026-07-15 (201->delete 204->404); kr-west1-a는 400 scp-network.ip.invalid-zone.",
          "method": "POST",
          "path": "/v1/publicips",
          "json": {
            "description": "API regression suite",
            "type": "IGW",
            "zone": "kr-west1-b",
            "tags": []
          },
          "expect_status": [
            200,
            201,
            202
          ],
          "capture": {
            "publicip_id": "$.publicip.id"
          },
          "cleanup": {
            "method": "DELETE",
            "path": "/v1/publicips/{publicip_id}",
            "service": "vpc"
          }
        },
        {
          "name": "wait-public-ip",
          "service": "vpc",
          "method": "GET",
          "path": "/v1/publicips/{publicip_id}",
          "expect_status": [
            200
          ],
          "poll": {
            "field": "$.publicip.state",
            "until": [
              "RESERVED",
              "Reserved",
              "ACTIVE",
              "CREATED",
              "RUNNING",
              "AVAILABLE"
            ],
            "timeout": 420,
            "interval": 15
          },
          "_note": "auto-repair R3-timeout-경계 (run-end 자동수리): 폴이 timeout 300s의 97%를 소진 (until 미충족) — 경계 플레이키 위험"
        },
        {
          "name": "verify-public-ip",
          "service": "vpc",
          "method": "GET",
          "path": "/v1/publicips/{publicip_id}",
          "expect_status": [
            200
          ],
          "group": "public-ip"
        },
        {
          "name": "delete-port",
          "service": "vpc",
          "method": "DELETE",
          "path": "/v1/ports/{port_id}",
          "expect_status": [
            200,
            202,
            204
          ],
          "destructive": true
        },
        {
          "name": "delete-subnet",
          "service": "vpc",
          "method": "DELETE",
          "path": "/v1/subnets/{subnet_id}",
          "expect_status": [
            200,
            202,
            204,
            409,
            404
          ],
          "destructive": true,
          "retry_on_status": [
            409
          ],
          "retries": 40,
          "retry_interval": 30,
          "adopt": "subnet"
        },
        {
          "name": "delete-internet-gateway",
          "adopt": "igw",
          "service": "vpc",
          "method": "DELETE",
          "path": "/v1/internet-gateways/{internet_gateway_id}",
          "expect_status": [
            200,
            202,
            204
          ],
          "destructive": true,
          "group": "internet-gateway",
          "_note": "2026-07-08: create와 같은 그룹 — create가 400(IGW 선점)이면 그룹 실패로 이 삭제가 스킵된다. find가 보충한 id는 다른 체인 소유일 수 있으므로 '자기가 만든 경우에만 삭제'가 이 그룹 묶음의 목적 (남의 IGW를 지우면 그 체인이 파괴됨)."
        },
        {
          "name": "delete-vpc",
          "service": "vpc",
          "method": "DELETE",
          "path": "/v1/vpcs/{vpc_id}",
          "expect_status": [
            200,
            202,
            204,
            409,
            404
          ],
          "destructive": true,
          "retry_on_status": [
            409
          ],
          "retries": 40,
          "retry_interval": 30,
          "adopt": "vpc"
        },
        {
          "name": "delete-public-ip",
          "service": "vpc",
          "method": "DELETE",
          "path": "/v1/publicips/{publicip_id}",
          "expect_status": [
            200,
            202,
            204
          ],
          "destructive": true,
          "retry_on_status": [
            400,
            409
          ],
          "retries": 24,
          "retry_interval": 15
        }
      ]
    }
  ]
}
